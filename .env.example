# ==============================================================================
# AstraZeneca Campaign Lab (UC4) — Environment Configuration
# Generic Multimodal Campaign & Brand Studio with Google Search Grounding
# ==============================================================================

# --- Google Cloud Project & Region ---
GOOGLE_CLOUD_PROJECT="gcp-ai-intelligence-dev-0a06"
GOOGLE_CLOUD_PROJECT_NUMBER="726684663091"
GOOGLE_CLOUD_LOCATION="europe-west1"
GOOGLE_GENAI_USE_VERTEXAI="TRUE"
VERTEX_GLOBAL_LOCATION="global"

# --- Storage & Asset Buckets (Dedicated UC4 Bucket / Prefix) ---
GCS_STAGING_BUCKET="gs://astrazeneca-ge-pilot-usecase"
GCS_ASSETS_BUCKET="astrazeneca-ge-pilot-usecase"
ARTIFACT_SERVICE_URI="gs://astrazeneca-ge-pilot-usecase"
GCS_FOLDER_PREFIX="UC4"
SIGNING_SERVICE_ACCOUNT="project-service-account@gcp-ai-intelligence-dev-0a06.iam.gserviceaccount.com"

# --- Gemini Enterprise & Vertex AI Agent Engine ---
GEMINI_ENTERPRISE_ENGINE_ID="gemini-enterprise-commerci_1781864147849"
GEMINI_ENTERPRISE_LOCATION="eu"
EXISTING_REASONING_ENGINE_ID="projects/726684663091/locations/europe-west1/reasoningEngines/5973077126683820032"

# --- Discovery Engine Datastore (Not needed for UC4 — uses Google Search Grounding + User Attachments) ---
ENABLE_DATASTORE="false"
DATASTORE_ID=""
DATASTORE_LOCATION="eu"

# --- Google Search Grounding ---
ENABLE_GOOGLE_GROUNDING="true"

# --- Gemini 3.1 & 4K Image Models ---
GEMINI_PRO_MODEL="gemini-3.1-pro-preview"
GEMINI_FLASH_MODEL="gemini-3-flash-preview"
GEMINI_IMAGE_MODEL="gemini-3-pro-image"
FALLBACK_IMAGE_MODEL="gemini-3.1-flash-image"
VEO_VIDEO_MODEL="veo-3.0-generate-001"
TTS_VOICE_NAME="en-GB-Neural2-B"

# --- Service & Agent Metadata ---
PORT="8080"
LOG_LEVEL="INFO"
SERVICE_NAME="AstraZeneca Campaign Lab"
AGENT_ICON_URI="gs://astrazeneca-ge-pilot-usecase/UC4/logos/astrazeneca_symbol_gold.png"
